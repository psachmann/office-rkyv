@inject WebUserSettingsService SettingsService

<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(OfficeRkyv.UI.Components.Layout.MainLayout).Assembly }" NotFoundPage="typeof(OfficeRkyv.UI.Components.Pages.NotFound)">
    <Found Context="routeData">
        @* A page that needs a signed-in user (the workspace) sends a visitor who is signed out to the landing page. *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(OfficeRkyv.UI.Components.Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLanding />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
