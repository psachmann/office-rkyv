@inherits LayoutComponentBase
@inject IHostEnvironment Env
@inject NavigationManager NavigationManager
@inject IStringLocalizer<MainLayout> Localizer

@if (Env.IsDevelopment())
{
    <QueryDevTools />
}

<QueryRefreshMonitor />

<RadzenComponents @rendermode="InteractiveServer" />

<CascadingValue Value="@CultureInfo.CurrentUICulture">
    <RadzenLayout>
        <RadzenHeader>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                    <RadzenSidebarToggle Click="@(() => IsExpanded = !IsExpanded)" />
                    <RadzenLabel Text="@Localizer["AppTitle"]" />
                </RadzenStack>
                <RadzenDropDown
                    TValue="string"
                    Data="@SupportedCultures.All"
                    TextProperty="@nameof(CultureInfo.NativeName)"
                    ValueProperty="@nameof(CultureInfo.Name)"
                    @bind-Value="@selectedCulture"
                    Change="@ChangeCulture"
                    AllowClear="false"
                    AllowFiltering="false"
                    class="rz-mr-4"
                />
            </RadzenStack>
        </RadzenHeader>
        <RadzenSidebar @bind-Expanded="@IsExpanded">
            <RadzenPanelMenu>
                <RadzenPanelMenuItem
                    Text="@Localizer["NavHome"]"
                    Icon="home"
                    Path="/"
                />
                <RadzenPanelMenuItem
                    Text="@Localizer["NavGreeter"]"
                    Icon="waving_hand"
                    Path="/greeter"
                />
                <RadzenPanelMenuItem
                    Text="@Localizer["NavError"]"
                    Icon="home"
                    Path="/error"
                />
            </RadzenPanelMenu>
        </RadzenSidebar>
        <RadzenBody>
            @Body
        </RadzenBody>
    </RadzenLayout>
</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    <i class="rzi" aria-hidden="true">error</i>
    @Localizer["UnhandledError"]
    <a href="." class="reload">@Localizer["Reload"]</a>
    <span class="dismiss"><i class="rzi" aria-hidden="true">close</i></span>
</div>


@code {
    public bool IsExpanded { get; set; } = true;

    private string selectedCulture = CultureInfo.CurrentUICulture.Name;

    private void ChangeCulture()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var redirectUri = Uri.EscapeDataString("/" + relativePath);

        NavigationManager.NavigateTo($"/culture/set?culture={selectedCulture}&redirectUri={redirectUri}", forceLoad: true);
    }
}
