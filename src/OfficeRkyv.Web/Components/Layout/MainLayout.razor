@inherits LayoutComponentBase
@inject IHostEnvironment Env

@if (Env.IsDevelopment())
{
    <QueryDevTools />
}

<QueryRefreshMonitor />

<RadzenComponents @rendermode="InteractiveServer" />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => IsExpanded = !IsExpanded)" />
            <RadzenLabel Text="Office Rkyv" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@IsExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem
                Text="Home"
                Icon="home"
                Path="/"
            />
            <RadzenPanelMenuItem
                Text="Error"
                Icon="home"
                Path="/error"
            />
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

<div id="blazor-error-ui" data-nosnippet>
    <i class="rzi" aria-hidden="true">error</i>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss"><i class="rzi" aria-hidden="true">close</i></span>
</div>


@code {
    public bool IsExpanded { get; set; } = true;
}
