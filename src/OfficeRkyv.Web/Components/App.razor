<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/OfficeRkyv.UI/app.css"]" />
    <link rel="stylesheet" href="@Assets["OfficeRkyv.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <AppTheme Preference="@preference" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" Appearance="@preference" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
</body>

</html>

@code {
    // The appearance the visitor chose, from the cookie the settings page writes. Read here, on the server,
    // so that the page is rendered in it from its first paint.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private AppearancePreference preference => Appearance.Parse(HttpContext?.Request.Cookies[Appearance.CookieName]);
}
