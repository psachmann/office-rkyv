@page "/settings"
@implements IDisposable
@inject IStringLocalizer<Settings> Localizer
@inject NavigationManager NavigationManager
@inject AppearanceState State

<PageTitle>@Localizer["Title"]</PageTitle>

<RadzenStack Gap="2rem" class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H3" data-testid="settings-heading">@Localizer["Heading"]</RadzenText>

    <RadzenStack Gap="0.5rem">
        <RadzenLabel Text="@Localizer["LanguageLabel"]" Component="Language" />
        <RadzenDropDown
            Name="Language"
            TValue="string"
            Data="@SupportedCultures.All"
            TextProperty="@nameof(CultureInfo.NativeName)"
            ValueProperty="@nameof(CultureInfo.Name)"
            @bind-Value="@selectedCulture"
            Change="@ChangeCulture"
            AllowClear="false"
            AllowFiltering="false"
            Style="max-width: 20rem"
            data-testid="language" />
    </RadzenStack>

    <RadzenStack Gap="0.5rem">
        <RadzenLabel Text="@Localizer["AppearanceLabel"]" Component="Appearance" />
        <RadzenSelectBar
            Name="Appearance"
            TValue="AppearancePreference"
            Value="@State.Preference"
            ValueChanged="@ChangeAppearance"
            data-testid="appearance">
            <Items>
                <RadzenSelectBarItem Text="@Localizer["AppearanceSystem"]" Value="AppearancePreference.System" />
                <RadzenSelectBarItem Text="@Localizer["AppearanceLight"]" Value="AppearancePreference.Light" />
                <RadzenSelectBarItem Text="@Localizer["AppearanceDark"]" Value="AppearancePreference.Dark" />
            </Items>
        </RadzenSelectBar>
        <RadzenText TextStyle="TextStyle.Caption">@Localizer["AppearanceHint"]</RadzenText>
    </RadzenStack>
</RadzenStack>

@code {
    private string selectedCulture = CultureInfo.CurrentUICulture.Name;

    protected override void OnInitialized() => State.Changed += OnAppearanceChanged;

    // A culture only takes effect on a fresh circuit, so this reloads the page (see CLAUDE.md); the redirect
    // lands back on this page.
    private void ChangeCulture()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var redirectUri = Uri.EscapeDataString("/" + relativePath);

        NavigationManager.NavigateTo($"/culture/set?culture={selectedCulture}&redirectUri={redirectUri}", forceLoad: true);
    }

    private Task ChangeAppearance(AppearancePreference preference) => State.SetAsync(preference);

    // Keeps the control in step when the appearance changes elsewhere, or is only adopted from the cookie
    // after this page has already rendered.
    private void OnAppearanceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnAppearanceChanged;
}
