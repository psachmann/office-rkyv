@page "/error"
@using System.Diagnostics
@inject IJSRuntime JsRuntime
@inject NotificationService NotificationService
@inject IStringLocalizer<Error> Localizer

<PageTitle>@Localizer["Title"]</PageTitle>

<RadzenStack Gap="1.5rem" class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H3">@Localizer["Heading"]</RadzenText>

    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Filled" AllowClose="false">
        @Localizer["GenericErrorMessage"]
    </RadzenAlert>

    @if (ShowRequestId)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0"><strong>@Localizer["RequestIdLabel"]</strong></RadzenText>
            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@RequestId" />
            <RadzenButton
                Icon="content_copy"
                ButtonStyle="ButtonStyle.Info"
                Variant="Variant.Text"
                Size="ButtonSize.ExtraSmall"
                Click="@CopyRequestIdAsync"
                title="@Localizer["CopyRequestIdTooltip"]"
            />
        </RadzenStack>
    }

    <RadzenCard Variant="Variant.Outlined">
        <RadzenText TextStyle="TextStyle.H5">@Localizer["DevModeHeading"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            @((MarkupString)Localizer["DevModeDescription"].Value)
        </RadzenText>
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false">
            @((MarkupString)Localizer["DevModeWarning"].Value)
        </RadzenAlert>
    </RadzenCard>
</RadzenStack>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    private async Task CopyRequestIdAsync()
    {
        if (string.IsNullOrEmpty(RequestId))
        {
            return;
        }

        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", RequestId);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = Localizer["CopiedSummary"],
                Detail = Localizer["CopiedDetail"],
                Duration = 3000,
            });
        }
        catch (JSException)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = Localizer["CopyFailedSummary"],
                Detail = Localizer["CopyFailedDetail"],
                Duration = 3000,
            });
        }
    }
}
