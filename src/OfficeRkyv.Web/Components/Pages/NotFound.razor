@page "/not-found"
@layout MainLayout
@inject NavigationManager NavigationManager
@inject IStringLocalizer<NotFound> Localizer

<PageTitle>@Localizer["Title"]</PageTitle>

<RadzenStack Gap="1.5rem" class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H3">@Localizer["Heading"]</RadzenText>

    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Filled" AllowClose="false">
        @Localizer["Message"]
    </RadzenAlert>

    <RadzenStack Orientation="Orientation.Horizontal">
        <RadzenButton
            Text="@Localizer["GoToHome"]"
            Icon="home"
            ButtonStyle="ButtonStyle.Primary"
            Click="@(() => NavigationManager.NavigateTo("/"))"
        />
    </RadzenStack>
</RadzenStack>
