@page "/not-found"
@layout MainLayout
@inject NavigationManager NavigationManager

<PageTitle>Not Found</PageTitle>

<RadzenStack Gap="1.5rem" class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H3">Not Found</RadzenText>

    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Filled" AllowClose="false">
        Sorry, the content you are looking for does not exist.
    </RadzenAlert>

    <RadzenStack Orientation="Orientation.Horizontal">
        <RadzenButton
            Text="Go to home"
            Icon="home"
            ButtonStyle="ButtonStyle.Primary"
            Click="@(() => NavigationManager.NavigateTo("/"))"
        />
    </RadzenStack>
</RadzenStack>
