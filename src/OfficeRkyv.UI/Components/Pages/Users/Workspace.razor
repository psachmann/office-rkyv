@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using OfficeRkyv.UI.Files
@page "/workspace"
@page "/workspace/archives/{ArchiveId:guid}"
@attribute [Authorize]
@implements IDisposable
@inject IStringLocalizer<Workspace> Localizer
@inject IStringLocalizer<WorkspaceErrors> ErrorLocalizer
@inject UsersFacade Users
@inject ArchivesFacade Archives
@inject DocumentsFacade Documents
@inject IQueryClient QueryClient
@inject IFileSaver FileSaver
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject ContextMenuService ContextMenuService
@inject NavigationManager Navigation
@inject ISignInService SignIn

<PageTitle>@Localizer["Title"]</PageTitle>

<RadzenStack Gap="1rem" class="rz-p-4">
    <Transition Query="@Users.FindUserById">
        <Content Context="found">
            @if (found.User is null)
            {
                @* The API has no such user any more, so this is nobody's workspace: the sign-in ends (see OnInitialized)
                   and the landing page follows. Nothing of a user is shown meanwhile. *@
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            }
            else
            {
                <SectionContent SectionId="MainLayout.WorkspaceNavigationSection">
                    @WorkspaceNavigation
                </SectionContent>

                @if (errorKey is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="true" Close="@(() => errorKey = null)" data-testid="workspace-error">@ErrorLocalizer[errorKey]</RadzenAlert>
                }

                <Transition Query="@Documents.FindInbox">
                    <Content Context="inbox">
                        <Transition Query="@Archives.FindArchives">
                            <Content Context="archives">
                                @{
                                    var selectedArchive = SelectedArchive(archives);
                                }
                                <RadzenStack Gap="1rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0" data-testid="workspace-selection">@(selectedArchive?.Name ?? Localizer["NavInbox"])</RadzenText>
                                            @if (selectedArchive is not null)
                                            {
                                                <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                              Click="@(() => OpenRenameArchiveDialog(selectedArchive))"
                                                              aria-label="@Localizer["RenameArchiveAria", selectedArchive.Name]" />
                                                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                                              Click="@(() => DeleteArchive(selectedArchive))"
                                                              aria-label="@Localizer["DeleteArchiveAria", selectedArchive.Name]" />
                                            }
                                        </RadzenStack>
                                        <RadzenButton Icon="note_add" Text="@Localizer["NewDocument"]" Click="@OpenCreateDocumentDialog" data-testid="new-document" />
                                    </RadzenStack>

                                    @if (ArchiveId is null)
                                    {
                                        @DocumentList(inbox, Localizer["EmptyInboxTitle"], Localizer["EmptyInboxText"])
                                    }
                                    else
                                    {
                                        <Transition Query="@Documents.FindArchiveDocuments">
                                            <Content Context="contents">
                                                @DocumentList(contents, Localizer["EmptyArchiveTitle"], Localizer["EmptyArchiveText"])
                                            </Content>
                                            <Loading>
                                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                                            </Loading>
                                            <Failure>
                                                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@Localizer["LoadFailed"]</RadzenAlert>
                                            </Failure>
                                        </Transition>
                                    }
                                </RadzenStack>
                            </Content>
                            <Loading>
                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                            </Loading>
                            <Failure>
                                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@Localizer["LoadFailed"]</RadzenAlert>
                            </Failure>
                        </Transition>
                    </Content>
                    <Loading>
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    </Loading>
                    <Failure>
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@Localizer["LoadFailed"]</RadzenAlert>
                    </Failure>
                </Transition>
            }
        </Content>
        <Loading>
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </Loading>
        <Failure>
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@Localizer["LoadFailed"]</RadzenAlert>
        </Failure>
    </Transition>
</RadzenStack>
@code {
    // Rendered into the layout's sidebar, so everything it calls stays on this page. The inbox and the archives are
    // two menus around the "Archives" heading, as a heading with a button cannot be an entry of a menu.
    private RenderFragment WorkspaceNavigation =>
        @<nav aria-label="@Localizer["NavLabel"]">
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Path="@WorkspaceAddresses.Inbox" Match="NavLinkMatch.All">
                    <Template>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-w-100">
                            <span class="rz-navigation-item-text" data-testid="nav-inbox">@Localizer["NavInbox"]</span>
                            <Transition Query="@Documents.FindInbox">
                                <Content Context="inbox">
                                    <RadzenBadge Text="@inbox.Count.ToString()" data-testid="nav-inbox-count" />
                                </Content>
                            </Transition>
                        </RadzenStack>
                    </Template>
                </RadzenPanelMenuItem>
            </RadzenPanelMenu>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-pt-4 rz-px-4">
                <RadzenText TextStyle="TextStyle.Overline" class="rz-m-0">@Localizer["NavArchives"]</RadzenText>
                <RadzenButton Icon="create_new_folder" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                              Text="@Localizer["NewArchive"]" Click="@OpenCreateArchiveDialog" data-testid="new-archive" />
            </RadzenStack>

            <Transition Query="@Archives.FindArchives">
                <Content Context="archives">
                    @if (archives.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-px-4" data-testid="no-archives">@Localizer["NoArchives"]</RadzenText>
                    }
                    else
                    {
                        <RadzenPanelMenu>
                            @foreach (var archive in archives)
                            {
                                <RadzenPanelMenuItem Path="@WorkspaceAddresses.Archive(archive.Id)">
                                    <Template>
                                        <span class="rz-navigation-item-text" data-testid="nav-archive">@archive.Name</span>
                                    </Template>
                                </RadzenPanelMenuItem>
                            }
                        </RadzenPanelMenu>
                    }
                </Content>
                <Loading>
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" class="rz-mx-4" />
                </Loading>
                <Failure>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-px-4" data-testid="archives-load-failed">@Localizer["LoadFailed"]</RadzenText>
                </Failure>
            </Transition>
        </nav>;

    private RenderFragment DocumentList(
        IReadOnlyList<DocumentDto> documents,
        string emptyTitle,
        string emptyText
    ) =>
        @<div>
            @if (documents.Count == 0)
            {
                <RadzenCard data-testid="empty-state">
                    <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center" class="rz-p-4">
                        <RadzenText TextStyle="TextStyle.H6">@emptyTitle</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@emptyText</RadzenText>
                    </RadzenStack>
                </RadzenCard>
            }
            else
            {
                <RadzenDataGrid TItem="DocumentDto" Data="@documents" AllowSorting="true"
                                RowRender="@(args => args.Attributes["data-testid"] = "document-row")">
                    <Columns>
                        <RadzenDataGridColumn TItem="DocumentDto" Property="@nameof(DocumentDto.Title)" Title="@Localizer["ColumnTitle"]" />
                        <RadzenDataGridColumn TItem="DocumentDto" Property="@nameof(DocumentDto.FileName)" Title="@Localizer["ColumnFile"]">
                            <Template Context="document">
                                <span data-testid="document-file">@document.FileName (@FileSize.Format(document.Size))</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DocumentDto" Title="" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                            <Template Context="document">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem">
                                    <RadzenButton Text="@Localizer["Download"]" Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                  Click="@(() => DownloadDocument(document))"
                                                  aria-label="@Localizer["DownloadAria", document.Title]" />
                                    <RadzenButton Text="@Localizer["Rename"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                  Click="@(() => OpenRenameDocumentDialog(document))" />
                                    <RadzenButton Text="@Localizer["FileInto"]" Icon="drive_file_move" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                  Click="@(args => OpenFileMenu(args, document))" />
                                    <RadzenButton Text="@Localizer["Delete"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                                  Click="@(() => DeleteDocument(document))" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </div>;
}
