@using Grpc.Core
@implements IDisposable
@inject IStringLocalizer<CreateUserDialog> Localizer
@inject UsersFacade Users
@inject DialogService DialogService

<RadzenTemplateForm TItem="CreateUserModel" Data="@model" Submit="@Submit">
    <RadzenStack Gap="1rem">
        @if (errors.General is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@Localizer[errors.General]</RadzenAlert>
        }

        <RadzenStack Gap="0.25rem">
            <RadzenFormField Text="@Localizer["EmailLabel"]" Component="Email">
                <RadzenTextBox Name="Email" @bind-Value="@model.Email" autocomplete="email" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="Email" Text="@Localizer["EmailRequired"]" Popup="false" />
            <RadzenEmailValidator Component="Email" Text="@Localizer["EmailInvalid"]" Popup="false" />
            @if (errors.Email is not null)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-danger">@Localizer[errors.Email]</RadzenText>
            }
        </RadzenStack>

        <RadzenStack Gap="0.25rem">
            <RadzenFormField Text="@Localizer["DisplayNameLabel"]" Component="DisplayName">
                <RadzenTextBox Name="DisplayName" @bind-Value="@model.DisplayName" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="DisplayName" Text="@Localizer["DisplayNameRequired"]" Popup="false" />
            @if (errors.DisplayName is not null)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-danger">@Localizer[errors.DisplayName]</RadzenText>
            }
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton
                ButtonType="ButtonType.Button"
                ButtonStyle="ButtonStyle.Light"
                Text="@Localizer["Cancel"]"
                Disabled="@isBusy"
                Click="@(() => DialogService.Close())" />
            <RadzenButton
                ButtonType="ButtonType.Submit"
                Text="@Localizer["Submit"]"
                IsBusy="@isBusy"
                BusyText="@Localizer["Creating"]" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private readonly CreateUserModel model = new();
    private IMutation<CreateUserRequest, UserDto> createUser = null!;
    private IDisposable? subscriptions;
    private CreateUserErrors errors = new();
    private bool isBusy;

    protected override void OnInitialized()
    {
        // This dialog's own mutation: it starts idle and only reports executions started from here.
        createUser = Users.CreateCreateUserMutation();
        subscriptions = new CompositeDisposable(
            createUser.Success.Subscribe(result => _ = InvokeAsync(() => DialogService.Close(true))),
            createUser.Failure.Subscribe(error => _ = InvokeAsync(() => ShowFailure(error)))
        );
    }

    // Only obvious mistakes are stopped here (Radzen's validators); whether the input is really valid,
    // and whether the email is taken, is the server's call and comes back through the mutation state.
    private void Submit()
    {
        errors = new();
        isBusy = true;
        createUser.Execute(new CreateUserRequest { Email = model.Email, DisplayName = model.DisplayName });
    }

    private void ShowFailure(Exception exception)
    {
        errors = CreateUserErrors.From(exception);
        isBusy = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        subscriptions?.Dispose();
        createUser?.Dispose();
    }

    private sealed class CreateUserModel
    {
        public string Email { get; set; } = "";
        public string DisplayName { get; set; } = "";
    }
}
