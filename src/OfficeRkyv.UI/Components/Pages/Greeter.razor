@page "/greeter"
@* Alias needed: inside this component, `Greeter` refers to the page itself, not the gRPC service. *@
@using GreeterClient = OfficeRkyv.Contracts.Greeter.GreeterClient
@using Grpc.Core
@using OfficeRkyv.Contracts
@inject GreeterClient GreeterClient
@inject IStringLocalizer<Greeter> Localizer

<PageTitle>@Localizer["Title"]</PageTitle>

<RadzenStack Gap="1rem" class="rz-p-4" Style="max-width: 32rem;">
    <RadzenText TextStyle="TextStyle.H3">@Localizer["Heading"]</RadzenText>

    <RadzenTemplateForm TItem="GreeterModel" Data="@model" Submit="@SayHello">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.5rem">
            <RadzenFormField Text="@Localizer["NameLabel"]" Style="flex: 1;">
                <RadzenTextBox @bind-Value="@model.Name" />
            </RadzenFormField>
            <RadzenButton ButtonType="ButtonType.Submit" Text="@Localizer["Submit"]" IsBusy="@isBusy" BusyText="@Localizer["Sending"]" />
        </RadzenStack>
    </RadzenTemplateForm>

    @if (reply is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" AllowClose="false">@reply</RadzenAlert>
    }

    @if (failed)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@Localizer["Failed"]</RadzenAlert>
    }
</RadzenStack>

@code {
    private readonly GreeterModel model = new();
    private string? reply;
    private bool failed;
    private bool isBusy;

    private async Task SayHello()
    {
        isBusy = true;
        failed = false;
        reply = null;

        try
        {
            var response = await GreeterClient.SayHelloAsync(new HelloRequest { Name = model.Name });
            reply = response.Message;
        }
        catch (RpcException)
        {
            failed = true;
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class GreeterModel
    {
        public string Name { get; set; } = "";
    }
}
