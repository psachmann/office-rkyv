@* Replaces RadzenTheme, which links one theme's stylesheet and cannot follow the operating system's
   light/dark preference. It renders what RadzenTheme rendered (the icon font preload, then the theme's
   stylesheet link), for both themes, with the media query that decides which one applies.

   Deliberately not interactive: an interactive component in the head is thrown away and re-created when the
   circuit starts, which re-fetches the stylesheets and shows the page unstyled for a moment on every load.
   These links are rendered once by the server; a change made on the settings page flips their media through
   the settings service instead. *@
<link rel="preload" href="_content/Radzen.Blazor/fonts/MaterialSymbolsOutlined.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
@foreach (var sheet in Appearance.Stylesheets(Preference))
{
    <link data-theme="@sheet.Theme" rel="stylesheet" href="@Href(sheet)" media="@sheet.Media" />
}

@code {
    private static readonly Version RadzenVersion = typeof(Radzen.Colors).Assembly.GetName().Version!;

    /// <summary>What the page is rendered with, read from the appearance cookie on the server.</summary>
    [Parameter] public AppearancePreference Preference { get; set; }

    private static string Href(ThemeStylesheet sheet) => $"_content/Radzen.Blazor/css/{sheet.Theme}-base.css?v={RadzenVersion}";
}
