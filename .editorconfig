root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,js,csx,cshtml,razor}]
indent_size = 4
max_line_length = 120

[*.cs]
# Log messages are declared with the [LoggerMessage] source generator (docs/observability.md). A direct
# logger.LogXxx(...) call is a warning, which fails the Release build.
dotnet_diagnostic.CA1848.severity = warning

[*.{config,csproj,props,slnx,targets,xaml,xml}]
indent_size = 2
max_line_length = 120
